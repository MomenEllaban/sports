{
  "name": "sports-champions-alexandria",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src scripts tests",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "npx tsx prisma/seed.ts",
    "seed:minimal": "npx tsx prisma/seed/run.ts minimal",
    "seed:demo": "npx tsx prisma/seed/run.ts demo",
    "seed:reset": "npx tsx prisma/seed/run.ts reset",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:int": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "check:invariants": "npx tsx scripts/check-invariants.ts",
    "test:smoke": "npx tsx --env-file=.env scripts/smoke-test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.3.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "next": "^15.1.0",
    "next-auth": "^4.24.11",
    "next-intl": "^3.26.3",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.0.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.25",
    "fast-check": "^4.10.1",
    "msw": "^2.15.0",
    "postcss": "^8.5.1",
    "prisma": "^6.3.0",
    "tailwindcss": "^4.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^5.0.1"
  }
}
