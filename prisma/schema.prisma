datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  BRANCH_MANAGER
  STAFF
  CASHIER
  FINANCE
}

enum OrderSource {
  ONLINE
  POS
  WHATSAPP
}

enum ShippingProvider {
  BOSTA
  MYLERZ
  // T15 DEPRECATED (kept for historic rows only — hidden from all UI):
  MRSOOL
  LOCAL_COURIER
  PICKUP
}

enum PaymentMethod {
  PAYMOB
  FAWRY
  COD
  INSTAPAY
  VODAFONE_CASH
  // T15 DEPRECATED (kept for historic rows only — initializePayment refuses it):
  KASHIER
  CASH
  CARD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum TransferStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum InventoryLogType {
  SALE
  RESTOCK
  TRANSFER
  ADJUSTMENT
  RETURN
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  RECEIVED
  CANCELLED
}

enum ExpenseCategory {
  RENT
  UTILITIES
  SALARIES
  MARKETING
  MAINTENANCE
  SUPPLIES
  TAXES
  OTHER
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum SalaryType {
  MONTHLY
  HOURLY
  COMMISSION
}

enum NotificationType {
  NEW_ORDER
  LOW_STOCK
  STOCK_TRANSFER
  PO_UPDATE
  PAYROLL_READY
  LARGE_DISCOUNT
  ETA_FAILURE
}

enum StocktakeStatus {
  DRAFT
  APPROVED
  CANCELLED
}

enum StocktakeLineStatus {
  PENDING
  COUNTED
  APPLIED
}

enum StocktakeReason {
  CYCLE_COUNT
  DAMAGE
  EXPIRY
  RECEIVING_ERROR
  SALE_ERROR
  THEFT
  OTHER
}

enum TaxInvoiceStatus {
  SUBMITTED
  VALID
  INVALID
  CANCELLED
}

model Branch {
  id           String   @id @default(cuid())
  name         String
  nameEn       String
  address      String
  addressEn    String
  phone        String
  city         String   @default("Alexandria")
  workingHours String   @default("Sat-Wed 10am-10pm, Thu-Fri 10am-11pm")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  inventories    BranchInventory[]
  transfersFrom  StockTransfer[]     @relation("TransferFromBranch")
  transfersTo    StockTransfer[]     @relation("TransferToBranch")
  orders         Order[]
  sales          Sale[]
  shifts         Shift[]
  returns        ReturnRequest[]
  inventoryLogs  InventoryLog[]
  stocktakeSessions StocktakeSession[]
  purchaseOrders PurchaseOrder[]
  expenses       Expense[]
  employees      Employee[]
  notifications  Notification[]
  taxInvoices    TaxInvoice[]
}

model BranchInventory {
  id                String   @id @default(cuid())
  branchId          String
  productId         String
  stockQuantity     Int      @default(0)
  lowStockThreshold Int      @default(5)
  reorderPoint      Int      @default(5)
  reorderQuantity   Int      @default(10)
  updatedAt         DateTime @updatedAt

  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([branchId, productId])
  @@index([stockQuantity])
  @@index([productId])
  reorderRequests ReorderRequest[]
}

model ReorderRequest {
  id               String   @id @default(cuid())
  branchInventoryId String
  productId        String
  supplierId       String?
  requestedById    String
  requestedAt      DateTime @default(now())
  neededAt         DateTime?
  note             String?
  quantity         Int
  unitCost         Decimal? @db.Decimal(12, 2)
  status           String   @default("REQUESTED")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  branchInventory BranchInventory @relation(fields: [branchInventoryId], references: [id], onDelete: Cascade)

  @@index([branchInventoryId, status, requestedAt])
  @@index([supplierId, status])
  @@index([requestedById, requestedAt])
}

model StocktakeSession {
  id              String          @id @default(cuid())
  stocktakeNumber String          @unique
  branchId        String
  status          StocktakeStatus @default(DRAFT)
  notes           String?
  createdById     String
  approvedById    String?
  startedAt       DateTime        @default(now())
  approvedAt      DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  branch Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  lines  StocktakeLine[]

  @@index([branchId, status, createdAt])
  @@index([createdById, createdAt])
}

model StocktakeLine {
  id                   String              @id @default(cuid())
  sessionId            String
  productId            String
  skuSnapshot          String
  nameArSnapshot       String
  nameEnSnapshot       String
  unitCost             Decimal             @db.Decimal(12, 2) @default(0.0)
  expectedQuantity     Int
  countedQuantity      Int?
  varianceQuantity     Int?
  previousQuantity     Int?
  newQuantity          Int?
  status               StocktakeLineStatus @default(PENDING)
  reasonCode           StocktakeReason?
  notes                String?
  countedById          String?
  countedAt            DateTime?
  appliedAt            DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  session StocktakeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  product Product          @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([sessionId, productId])
  @@index([sessionId, status])
  @@index([productId])
}

model StockTransfer {
  id             String         @id @default(cuid())
  transferNumber String         @unique
  fromBranchId   String
  toBranchId     String
  status         TransferStatus @default(PENDING)
  requestedById  String
  approvedById   String?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  fromBranch Branch              @relation("TransferFromBranch", fields: [fromBranchId], references: [id])
  toBranch   Branch              @relation("TransferToBranch", fields: [toBranchId], references: [id])
  items      StockTransferItem[]
}

model StockTransferItem {
  id         String @id @default(cuid())
  transferId String
  productId  String
  quantity   Int

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id])
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  role         Role     @default(STAFF)
  branchIds    String[] @default([])
  // T05: home branch for branch-scoped roles (CASHIER sells only here).
  branchId     String?
  // T06: manager discount PIN (bcrypt hash) + brute-force protection.
  managerPinHash    String?
  pinFailedAttempts Int       @default(0)
  pinLockedUntil    DateTime?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee Employee?
  shifts   Shift[]
}

model Employee {
  id             String     @id @default(cuid())
  userId         String?    @unique
  name           String
  phone          String
  roleTitle      String
  salary         Decimal @db.Decimal(12, 2)
  salaryType     SalaryType @default(MONTHLY)
  commissionRate Float      @default(0.0)
  branchId       String
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user         User?         @relation(fields: [userId], references: [id])
  branch       Branch        @relation(fields: [branchId], references: [id])
  payrollItems PayrollItem[]
}

model PayrollRun {
  id          String        @id @default(cuid())
  periodMonth Int
  periodYear  Int
  status      PayrollStatus @default(DRAFT)
  totalAmount Decimal @db.Decimal(12, 2)         @default(0.0)
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  items PayrollItem[]
}

model PayrollItem {
  id               String        @id @default(cuid())
  payrollRunId     String
  employeeId       String
  baseSalary       Decimal @db.Decimal(12, 2)
  bonus            Decimal @db.Decimal(12, 2)         @default(0.0)
  deductions       Decimal @db.Decimal(12, 2)         @default(0.0)
  commissionAmount Decimal @db.Decimal(12, 2)         @default(0.0)
  netSalary        Decimal @db.Decimal(12, 2)
  status           PayrollStatus @default(DRAFT)

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id])
}

model Customer {
  id            String   @id @default(cuid())
  phone         String   @unique
  name          String?
  email         String?
  loyaltyPoints Int      @default(0)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  addresses Address[]
  orders    Order[]
  sales     Sale[]
  wishlistItems WishlistItem[]
}

model WishlistItem {
  customerId String
  productId  String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([customerId, productId])
  @@index([customerId, createdAt])
  @@index([productId])
}

model Address {
  id          String  @id @default(cuid())
  customerId  String
  title       String  @default("Home")
  street      String
  building    String?
  city        String  @default("Alexandria")
  governorate String  @default("Alexandria")
  isDefault   Boolean @default(true)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  nameAr      String
  nameEn      String
  description String?
  image       String?
  products    Product[]
}

model Brand {
  id       String    @id @default(cuid())
  slug     String    @unique
  nameAr   String
  nameEn   String
  logo     String?
  products Product[]
}

model Product {
  id            String   @id @default(cuid())
  sku           String   @unique
  barcode       String?  @unique
  nameAr        String
  nameEn        String
  descriptionAr String?
  descriptionEn String?
  price         Decimal @db.Decimal(12, 2)
  costPrice     Decimal @db.Decimal(12, 2)    @default(0.0)
  categoryId    String
  brandId       String?
  size          String?
  color         String?
  isFeatured    Boolean  @default(false)
  isActive      Boolean  @default(true)
  images        String[] @default([])
  // ETA-spike: GS1 GTIN per SKU for production e-invoicing (T14).
  gs1Code       String?
  // T07: display family for size/color variants (SKUs stay independent).
  groupSlug     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category           Category            @relation(fields: [categoryId], references: [id])
  brand              Brand?              @relation(fields: [brandId], references: [id])
  inventories        BranchInventory[]
  orderItems         OrderItem[]
  saleItems          SaleItem[]
  purchaseOrderItems PurchaseOrderItem[]
  transferItems      StockTransferItem[]
  inventoryLogs      InventoryLog[]
  reviews            Review[]
  returnItems        ReturnItem[]
  stocktakeLines     StocktakeLine[]
  wishlistItems      WishlistItem[]

  @@index([isActive, categoryId])
  @@index([groupSlug])
  @@index([brandId])
  @@index([isFeatured])
}

model Order {
  id               String           @id @default(cuid())
  orderNumber      String           @unique
  orderSource      OrderSource      @default(ONLINE)
  customerId       String?
  guestPhone       String
  guestName        String?
  deliveryAddress  String
  // T09: saved portal address used (text snapshot stays for history).
  addressId        String?
  branchId         String
  deliveryZone     String           @default("Alexandria Central")
  deliveryFee      Decimal @db.Decimal(12, 2)            @default(30.0)
  shippingProvider ShippingProvider @default(BOSTA)
  trackingNumber   String?
  paymentMethod    PaymentMethod    @default(COD)
  paymentStatus    PaymentStatus    @default(PENDING)
  orderStatus      OrderStatus      @default(PENDING)
  subtotal         Decimal @db.Decimal(12, 2)
  taxAmount        Decimal @db.Decimal(12, 2)            @default(0.0)
  discountAmount   Decimal @db.Decimal(12, 2)            @default(0.0)
  totalAmount      Decimal @db.Decimal(12, 2)
  codReconciled    Boolean          @default(false)
  // 3.3: cash actually remitted by the courier for this COD order.
  codRemitted      Decimal @db.Decimal(12, 2) @default(0.0)
  etaReceiptId     String?
  // 2.3: customer-uploaded transfer receipt (InstaPay / Vodafone Cash) for manual review.
  receiptImage     String?
  // 3.1: gateway transaction reference (Paymob/Fawry) for webhook matching.
  paymentRef       String?
  // T16: unified discount pipeline attribution.
  couponCode       String?
  loyaltyRedeemed  Int      @default(0)
  loyaltyDiscount  Decimal @db.Decimal(12, 2) @default(0.0)
  couponDiscount   Decimal @db.Decimal(12, 2) @default(0.0)
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  // B02: optimistic version for safe order edits.
  editVersion      Int              @default(0)

  branch     Branch      @relation(fields: [branchId], references: [id])
  customer   Customer?   @relation(fields: [customerId], references: [id])
  items      OrderItem[]
  taxInvoice TaxInvoice?
  returns    ReturnRequest[]
  // T-RMA derived status: NONE | PARTIAL | FULL (RETURNED only when FULL).
  returnStatus String @default("NONE")

  @@index([orderStatus, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([branchId, createdAt])
  @@index([customerId])
  @@index([createdAt])
}

model OrderItem {
  id         String @id @default(cuid())
  orderId    String
  productId  String
  unitPrice  Decimal @db.Decimal(12, 2)
  quantity   Int
  totalPrice Decimal @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Sale {
  id             String        @id @default(cuid())
  saleNumber     String        @unique
  branchId       String
  cashierId      String
  customerId     String?
  subtotal       Decimal @db.Decimal(12, 2)
  taxAmount      Decimal @db.Decimal(12, 2)         @default(0.0)
  discountAmount Decimal @db.Decimal(12, 2)         @default(0.0)
  totalAmount    Decimal @db.Decimal(12, 2)
  paymentMethod  PaymentMethod @default(CASH)
  paymentStatus  PaymentStatus @default(PAID)
  status         String        @default("COMPLETED")
  etaReceiptId   String?
  // T06: who approved a manager discount (manager PIN user or BM/SA session).
  approvedById   String?
  // T07: offline-sync idempotency key (nullable unique).
  clientSaleId   String?  @unique
  // T05: shift this sale belongs to (set at sale time, incl. offline sync).
  shiftId        String?
  // T16: unified discount pipeline attribution.
  couponCode       String?
  loyaltyRedeemed  Int      @default(0)
  loyaltyDiscount  Decimal @db.Decimal(12, 2) @default(0.0)
  couponDiscount   Decimal @db.Decimal(12, 2) @default(0.0)
  createdAt      DateTime      @default(now())

  branch     Branch      @relation(fields: [branchId], references: [id])
  customer   Customer?   @relation(fields: [customerId], references: [id])
  shift      Shift?      @relation(fields: [shiftId], references: [id])
  items      SaleItem[]
  taxInvoice TaxInvoice?
  returns    ReturnRequest[]
  // T-RMA derived status: NONE | PARTIAL | FULL.
  returnStatus String @default("NONE")

  @@index([branchId, createdAt])
  @@index([cashierId, createdAt])
  @@index([createdAt])
  @@index([shiftId])
}

// T05: cashier shifts (cash drawer sessions). One OPEN shift per cashier max.
model Shift {
  id           String      @id @default(cuid())
  branchId     String
  cashierId    String
  status       ShiftStatus @default(OPEN)
  openedAt     DateTime    @default(now())
  closedAt     DateTime?
  openingFloat Decimal @db.Decimal(12, 2) @default(0)
  expectedCash Decimal @db.Decimal(12, 2) @default(0)
  actualCash   Decimal @db.Decimal(12, 2) @default(0)
  difference   Decimal @db.Decimal(12, 2) @default(0)
  openNote     String?
  closeNote    String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  branch Branch @relation(fields: [branchId], references: [id])
  cashier User   @relation(fields: [cashierId], references: [id])
  sales  Sale[]
  refunds Refund[]

  @@index([cashierId, status])
  @@index([branchId, status])
}

model SaleItem {
  id         String @id @default(cuid())
  saleId     String
  productId  String
  unitPrice  Decimal @db.Decimal(12, 2)
  quantity   Int
  discount   Decimal @db.Decimal(12, 2)  @default(0.0)
  totalPrice Decimal @db.Decimal(12, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

model InventoryLog {
  id               String           @id @default(cuid())
  branchId         String
  productId        String
  type             InventoryLogType
  changeQuantity   Int
  previousQuantity Int
  newQuantity      Int
  referenceId      String?
  notes            String?
  createdById      String?
  createdAt        DateTime         @default(now())

  branch  Branch  @relation(fields: [branchId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([branchId, productId, createdAt])
  @@index([referenceId])
  @@index([createdAt])
}

model Supplier {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  taxNumber     String?
  createdAt     DateTime @default(now())

  purchaseOrders PurchaseOrder[]
  payments       SupplierPayment[]
}

// T13: supplier payments ledger (cash paid to suppliers, linked to POs optionally).
model SupplierPayment {
  id          String   @id @default(cuid())
  supplierId  String
  amount      Decimal @db.Decimal(12, 2)
  method      String   @default("CASH")
  reference   String?
  notes       String?
  createdById String?
  createdAt   DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  poNumber    String              @unique
  supplierId  String
  branchId    String
  status      PurchaseOrderStatus @default(DRAFT)
  totalAmount Decimal @db.Decimal(12, 2)               @default(0.0)
  notes       String?
  createdById String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  supplier Supplier            @relation(fields: [supplierId], references: [id])
  branch   Branch              @relation(fields: [branchId], references: [id])
  items    PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id               String @id @default(cuid())
  purchaseOrderId  String
  productId        String
  unitCost         Decimal @db.Decimal(12, 2)
  quantityOrdered  Int
  quantityReceived Int    @default(0)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])
}

model Expense {
  id            String          @id @default(cuid())
  expenseNumber String          @unique
  branchId      String
  category      ExpenseCategory @default(OTHER)
  description   String
  amount        Decimal @db.Decimal(12, 2)
  receiptImage  String?
  date          DateTime        @default(now())
  createdById   String
  createdAt     DateTime        @default(now())

  branch Branch @relation(fields: [branchId], references: [id])
}

model Notification {
  id         String           @id @default(cuid())
  titleAr    String
  titleEn    String
  messageAr  String
  messageEn  String
  type       NotificationType
  targetRole Role?
  branchId   String?
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())

  branch Branch? @relation(fields: [branchId], references: [id])

  @@index([branchId, isRead, createdAt])
}

model TaxInvoice {
  id              String           @id @default(cuid())
  invoiceNumber   String           @unique
  etaUuid         String?          @unique
  orderId         String?          @unique
  saleId          String?          @unique
  branchId        String
  totalAmount     Decimal @db.Decimal(12, 2)
  vatAmount       Decimal @db.Decimal(12, 2)
  qrCodeData      String?
  status          TaxInvoiceStatus @default(SUBMITTED)
  etaResponseText String?
  // Immutable presentation snapshot captured at issuance; legacy rows may be null.
  snapshot         Json?
  snapshotSource   String           @default("LEGACY_RECONSTRUCTED")
  reprintCount     Int              @default(0)
  lastReprintedAt  DateTime?
  createdAt        DateTime         @default(now())

  branch   Branch          @relation(fields: [branchId], references: [id])
  reprints InvoiceReprint[]
  order  Order? @relation(fields: [orderId], references: [id])
  sale   Sale?  @relation(fields: [saleId], references: [id])
}

model InvoiceReprint {
  id           String   @id @default(cuid())
  taxInvoiceId String
  requestId    String   @unique
  copyNumber   Int
  locale       String   @default("ar")
  reason       String?
  printedById  String?
  createdAt    DateTime @default(now())

  taxInvoice TaxInvoice @relation(fields: [taxInvoiceId], references: [id], onDelete: Cascade)

  @@index([taxInvoiceId, createdAt])
}


model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  kind        String    @default("PERCENT") // PERCENT | FIXED
  value       Decimal @db.Decimal(12, 2)
  capAmount   Decimal @db.Decimal(12, 2) @default(0.0)
  minTotal    Decimal @db.Decimal(12, 2) @default(0.0)
  startsAt    DateTime?
  endsAt      DateTime?
  usageLimit  Int?
  usedCount   Int       @default(0)
  isActive    Boolean   @default(true)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  uses CouponUse[]
}

model CouponUse {
  id         String   @id @default(cuid())
  couponId   String
  orderId    String?
  saleId     String?
  customerId String?
  amount     Decimal @db.Decimal(12, 2)
  createdAt  DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@index([couponId])
}

// T08: product reviews (visible only after staff approval).
model Review {
  id         String   @id @default(cuid())
  productId  String
  customerId String?
  phone      String?
  rating     Int
  text       String?
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, approved])
}

// T-RMA: unified returns domain (single path — see docs/RETURNS_AUDIT.md).
// ReturnRequest: one RMA case (partial or full, return or exchange).
model ReturnRequest {
  id             String   @id @default(cuid())
  returnNumber   String   @unique
  orderId        String?
  saleId         String?
  type           String   @default("RETURN") // RETURN | EXCHANGE
  channel        String   @default("ADMIN") // POS | ONLINE | WHATSAPP | ADMIN | AUTO_COURIER
  branchId       String
  status         String   @default("REQUESTED") // REQUESTED|APPROVED|RECEIVED|REFUND_PENDING|COMPLETED|REJECTED|CANCELLED
  customerId     String?
  customerPhone  String?
  requestedById  String?
  approvedById   String?
  receivedById   String?
  refundedById   String?
  source         String   @default("NEW") // NEW | LEGACY
  notes          String?
  exchangeSaleId String?
  // T-RMA idempotency for double-submit protection (nullable unique).
  clientRequestId String?  @unique
  // T-RMA ETA credit-note marker: NONE | SENT | PENDING_ETA.
  etaStatus      String   @default("NONE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  order  Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  sale   Sale?   @relation(fields: [saleId], references: [id], onDelete: SetNull)
  branch Branch  @relation(fields: [branchId], references: [id])
  items  ReturnItem[]
  refunds Refund[]

  @@index([status])
  @@index([orderId])
  @@index([saleId])
}

model ReturnItem {
  id           String   @id @default(cuid())
  returnId     String
  orderItemId  String?
  saleItemId   String?
  productId    String
  quantity     Int
  reasonCode   String   @default("OTHER")
  condition    String   @default("GOOD") // GOOD | DAMAGED | DEFECTIVE
  disposition  String   @default("RESTOCK") // RESTOCK | DAMAGED | INSPECT
  refundAmount Decimal @db.Decimal(12, 2) @default(0.0)
  notes        String?
  images       String[] @default([])
  createdAt    DateTime @default(now())

  return  ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id])

  @@index([returnId])
}

// T-RMA: payout outbox. The transaction records it; a worker executes it.
model Refund {
  id             String   @id @default(cuid())
  returnId       String
  amount         Decimal @db.Decimal(12, 2)
  method         String   @default("ORIGINAL_GATEWAY") // CASH|ORIGINAL_GATEWAY|INSTAPAY|VODAFONE|BANK_TRANSFER
  status         String   @default("PENDING") // PENDING|PROCESSING|DONE|FAILED|MANUAL_REQUIRED
  gatewayRef     String?
  idempotencyKey String   @unique
  attempts       Int      @default(0)
  lastError      String?
  shiftId        String?
  proofImage     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  return ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  shift  Shift?         @relation(fields: [shiftId], references: [id])

  @@index([status])
}
// T02: generic key/value store for all configurable business values (T12 builds service + UI).
// Values are JSON-encoded strings; seed fills defaults, admins edit them.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// T12: audit trail for sensitive actions.
model AuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  branchId  String?
  metadata  String?

  @@index([createdAt, entity])
  @@index([entityId])
}
