# App environment: development | staging | production.
# Destructive scripts (seed:reset, test bootstrap) refuse to run unless development.
APP_ENV="development"

# Database Connection (Neon PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# Prisma direct connection (recommended for Neon migrations/seed)
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Test database: SEPARATE database on the same server (never a schema on the app DB —
# Prisma Client ignores the `schema` URL param at runtime, so a schema does NOT isolate).
# MUST contain "test" and differ from DATABASE_URL. The test bootstrap REFUSES otherwise.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST/sports_test_db?sslmode=require"

# NextAuth Secret & URL
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Development/test seed only; never use a production password here.
SEED_DEFAULT_PASSWORD="replace-for-local-qa"
SEED_RESET_CREDENTIALS="false"
SEED_MANAGER_PIN_PRIMARY=""
SEED_MANAGER_PIN_SECONDARY=""

# Encryption for the settings vault (required in production; generate a 32-byte key)
SETTINGS_ENCRYPTION_KEY="replace-with-a-32-byte-base64-key"

# Cloudinary Storage & Image Hosting — never commit real values
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
CLOUDINARY_URL="cloudinary://your-api-key:your-api-secret@your-cloud-name"

# Egyptian Tax Authority (ETA) Integration
ETA_ENABLED="false"
ETA_TAX_REGISTRATION_NUMBER="your-official-tax-number"
ETA_CLIENT_ID="eta_client_id"
ETA_CLIENT_SECRET="eta_client_secret"
ETA_API_BASE_URL="https://api.invoicing.eta.gov.eg"
ETA_SIGNING_URL=""

# Payment Gateways (Egypt)
PAYMOB_API_KEY="paymob_api_key"
PAYMOB_INTEGRATION_ID="paymob_integration_id"
PAYMOB_FRAMES_ID="paymob_iframe_id"
PAYMOB_HMAC_SECRET="paymob_hmac_secret"
FAWRY_MERCHANT_CODE="fawry_merchant_code"
FAWRY_SECURE_KEY="fawry_security_key"
KASHIER_MERCHANT_ID="kashier_merchant_id"
KASHIER_API_KEY="kashier_api_key"

# Logistics (Egypt) + webhook verification
BOSTA_API_KEY="bosta_api_key"
BOSTA_WEBHOOK_SECRET="bosta_webhook_secret"
MYLERZ_API_KEY="mylerz_api_key"
MYLERZ_WEBHOOK_SECRET="mylerz_webhook_secret"
MRSOOL_API_KEY="mrsool_api_key"

# WhatsApp Business API
WHATSAPP_API_TOKEN="whatsapp_api_token"
WHATSAPP_PHONE_NUMBER_ID="whatsapp_phone_number_id"

# Optional provider modes; use mock only in non-production development.
PAYMOB_PROVIDER="live"
FAWRY_PROVIDER="live"
BOSTA_PROVIDER="live"
MYLERZ_PROVIDER="live"
SENTRY_DSN=""
